{
  "buildCommand": "cd ../.. && npm install && cd apps/web && npx next build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://coopgig-api.onrender.com/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://coopgig-api.onrender.com/ws/:path*"
    }
  ]
}
